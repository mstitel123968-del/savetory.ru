# Production environment variables for Trezo
# Replace placeholder values with deployment secrets before running in production.
DEBUG=0
SECRET_KEY=CHANGE_ME_TO_A_STRONG_RANDOM_VALUE
DJANGO_ALLOWED_HOSTS=168.222.192.249 savetory.ru www.savetory.ru
DJANGO_CSRF_TRUSTED_ORIGINS=http://savetory.ru https://savetory.ru http://www.savetory.ru https://www.savetory.ru http://168.222.192.249 https://168.222.192.249

# Database configuration
DB_NAME=trezo_prod
DB_USER=trezo_user
DB_PASSWORD=CHANGE_ME
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_DB=trezo_prod
POSTGRES_USER=trezo_user
POSTGRES_PASSWORD=CHANGE_ME
DATABASE_URL=postgres://${DB_USER}:${DB_PASSWORD}@db:5432/${DB_NAME}

# Optional Yandex Object Storage (S3-compatible) for user media files.
# Leave YANDEX_STORAGE_ENABLED=0 to keep media on the local filesystem.
# Set it to 1 and fill in the AWS_* values below to store media in the bucket.
YANDEX_STORAGE_ENABLED=0
#AWS_ACCESS_KEY_ID=your-access-key-id
#AWS_SECRET_ACCESS_KEY=your-secret-access-key
#AWS_STORAGE_BUCKET_NAME=your-bucket-name
#AWS_S3_ENDPOINT_URL=https://storage.yandexcloud.net
#AWS_S3_REGION_NAME=ru-central1

# Optional email backend configuration
#EMAIL_HOST=smtp.example.com
#EMAIL_HOST_USER=your-user
#EMAIL_HOST_PASSWORD=your-password
#EMAIL_PORT=587
#EMAIL_USE_TLS=1

# YooKassa payments. Do not commit real credentials.
YOOKASSA_ENABLED=0
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
SITE_URL=https://example.com
YOOKASSA_RETURN_URL=https://example.com/subscriptions/payment/result/
YOOKASSA_SEND_RECEIPT=0
YOOKASSA_VAT_CODE=
